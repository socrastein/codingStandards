{
  "name": "coding-standards",
  "version": "0.1.0",
  "private": true,
  "description": "Matt's coding standards for every project: the standards document, the exemplars, and the tools that check them.",
  "type": "module",
  "scripts": {
    "measure": "node measure/measure.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.12.0",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
